<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Granted only because this app is signed with the super app's certificate. -->
    <uses-permission android:name="org.mosip.superapp.permission.NATIVE_SSO" />

    <!-- Android 11+ package visibility: let this app find the super app's SSO provider. -->
    <queries>
        <package android:name="org.mosip.superapp" />
        <provider android:authorities="org.mosip.superapp.sso" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MosipChildApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Only used on the re-consent fallback, when the exchange answers interaction_required. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.mosip.childapp" android:host="callback" />
            </intent-filter>
        </activity>
    </application>
</manifest>
