<?xml version="1.0" encoding="utf-8"?>
<!-- Demo only: the local eSignet runs over plain HTTP (reached through `adb reverse` as localhost
     or over the LAN). A production app must only talk to eSignet over HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
