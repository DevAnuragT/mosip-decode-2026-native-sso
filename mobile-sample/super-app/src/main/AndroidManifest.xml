<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signature-level permission: only apps signed with the same vendor certificate can hold it. -->
    <permission
        android:name="org.mosip.superapp.permission.NATIVE_SSO"
        android:label="@string/permission_label"
        android:description="@string/permission_description"
        android:protectionLevel="signature" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.MosipSuperApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- eSignet redirects the browser back here with the authorization code. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="org.mosip.superapp" android:host="callback" />
            </intent-filter>
        </activity>

        <!-- Native SSO IPC endpoint for same-vendor child apps (task 7). -->
        <provider
            android:name=".NativeSsoProvider"
            android:authorities="org.mosip.superapp.sso"
            android:exported="true"
            android:permission="org.mosip.superapp.permission.NATIVE_SSO" />
    </application>
</manifest>
