# esignet-service/.env used for the Native SSO demo (developer mode; see repos/esignet-go/docker-compose/README.md
# Option B). Copy to repos/esignet-go/esignet-service/.env and adjust the absolute DATA_DIR path.
LOG_LEVEL=info
PORT=8088
MOSIP_ESIGNET_HOST=http://localhost:8088
MOSIP_ESIGNET_OIDC_UI_SCHEME=http
MOSIP_ESIGNET_OIDC_UI_HOSTNAME=localhost
MOSIP_ESIGNET_OIDC_UI_PORT=3000
MOSIP_ESIGNET_OIDC_UI_LOGIN_PATH=/signin
MOSIP_ESIGNET_OIDC_UI_ERROR_PATH=/error
DATABASE_HOST=localhost
DATABASE_PORT=5455
DATABASE_NAME=mosip_esignet
DATABASE_USERNAME=postgres
DB_DBUSER_PASSWORD=postgres
DATABASE_PASSWORD=postgres
MOSIP_ESIGNET_CACHE_TYPE=inmemory
KEYMANAGER_DB_SCHEMA=esignet
KEYMANAGER_KEYSTORE_TYPE=PKCS12
KEYMANAGER_PKCS12_FILE_PATH=./keystore.pfx
KEYMANAGER_PKCS12_PASSWORD=localtest
KEYMANAGER_PKCS12_ALLOW_INSECURE_SOFTWARE_KEYSTORE=true
MOSIP_ESIGNET_AUTHN_PROVIDER=mock
MOSIP_ESIGNET_MOCK_DOMAIN_URL=http://localhost:8082
# Native SSO: device secret lifetime (30 days)
MOSIP_ESIGNET_DEVICE_SECRET_VALIDITY_SECONDS=2592000
# Captcha for local demos: Cloudflare Turnstile dummy key auto-passes (no validator URL configured locally)
MOSIP_ESIGNET_CAPTCHA_SITE_PROVIDER=cloudflare-turnstile
MOSIP_ESIGNET_CAPTCHA_SITE_KEY=1x00000000000000000000AA
# Modern login theme + data overlay (ui-theme/); quote the path if it contains spaces
MOSIP_ESIGNET_THEME_ID=theme-modern
DATA_DIR="/absolute/path/to/this/repo/ui-theme/esignet-data"
